{
  "name": "vite-playground",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && tsc --noEmit",
    "preview": "bun --bun vite preview",
    "start": "node .output/server/index.mjs",
    "check-types": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@anhur/assets": "workspace:*",
    "@anhur/core": "workspace:*",
    "@anhur/markdown": "workspace:*",
    "@anhur/mdx": "workspace:*",
    "@anhur/vite": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260311-beta",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.14"
  }
