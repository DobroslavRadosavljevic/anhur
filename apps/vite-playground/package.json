{
  "name": "vite-playground",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build && tsc --noEmit",
    "build:assets": "ANHUR_ASSETS_UPLOAD=1 bun --bun vite build && tsc --noEmit",
    "preview": "bun --bun vite preview",
    "start": "node .output/server/index.mjs",
    "check-types": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt ."
  },
  "dependencies": {
    "@anhur/assets": "workspace:*",
    "@anhur/core": "workspace:*",
    "@anhur/markdown": "workspace:*",
    "@anhur/mdx": "workspace:*",
    "@anhur/orama": "workspace:*",
    "@anhur/vite": "workspace:*",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-presigned-post": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "files-sdk": "^2.4.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.2",
    "nitro": "3.0.260311-beta",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
