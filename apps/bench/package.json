    "@anhur/orama": "workspace:*",
    "jiti": "^2.7.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@types/node": "^22.20.2",
    "bellona": "0.5.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2"
