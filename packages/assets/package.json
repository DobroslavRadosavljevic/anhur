{
  "name": "@anhur/assets",
  "version": "0.0.14",
  "description": "Opt-in image/file asset helpers for @anhur/core documents, with optional CDN sync via files-sdk",
  "keywords": [
    "anhur",
    "assets",
    "cdn",
    "content",
    "files-sdk",
    "image",
    "s3",
    "sharp"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@anhur/core": "workspace:*",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-presigned-post": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@mdx-js/mdx": "^3.1.1",
    "@testcontainers/minio": "^12.1.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.2",
    "files-sdk": "^2.4.1",
    "mdast": "^3.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "remark-gfm": "^4.0.1",
    "testcontainers": "^12.1.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "files-sdk": "^2.4.1"
  },
  "peerDependenciesMeta": {
    "files-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "inlinedDependencies": {
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3"
  }
}
