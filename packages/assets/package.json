{
  "name": "@anhur/assets",
  "version": "0.1.0",
  "description": "Image and file fields for @anhur/core: content-hashed copies, sizes, blur placeholders, optional CDN upload",
  "keywords": [
    "anhur",
    "assets",
    "cdn",
    "content",
    "files-sdk",
    "image",
    "s3",
    "sharp"
  ],
  "homepage": "https://github.com/DobroslavRadosavljevic/anhur/tree/main/packages/assets#readme",
  "bugs": {
    "url": "https://github.com/DobroslavRadosavljevic/anhur/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DobroslavRadosavljevic/anhur.git",
    "directory": "packages/assets"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@anhur/core": "workspace:*",
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-presigned-post": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@testcontainers/minio": "^12.1.0",
    "@types/node": "^22.20.2",
    "bellona": "0.5.0",
    "files-sdk": "^2.4.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sharp": "^0.35.4",
    "testcontainers": "^12.1.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@anhur/core": "workspace:^",
    "files-sdk": "^2.4.1",
    "sharp": ">=0.34.3",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "files-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
