{
  "name": "@anhur/core",
  "version": "0.0.14",
  "description": "Typed content from Markdown, MDX, YAML and JSON files: define collections, validate with Zod, import generated modules",
  "keywords": [
    "content",
    "effect",
    "i18n",
    "markdown",
    "mdx",
    "vite",
    "zod"
  ],
  "homepage": "https://github.com/DobroslavRadosavljevic/anhur/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/DobroslavRadosavljevic/anhur/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DobroslavRadosavljevic/anhur.git",
    "directory": "packages/core"
  },
  "bin": {
    "anhur": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build/index.ts",
    "./plugin": "./src/plugin/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "anhur": "./dist/cli.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./build": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "effect": "4.0.0-rc.115",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "jiti": "^2.7.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "pluralize": "^8.0.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@effect/vitest": "^4.0.0-rc.115",
    "@types/node": "^22.20.2",
    "@types/pluralize": "^0.0.33",
    "bellona": "0.5.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "zod": "^4.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
