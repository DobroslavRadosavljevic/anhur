{
  "name": "@anhur/mdx",
  "version": "0.1.0",
  "description": "MDX fields for @anhur/core and a cached React renderer",
  "keywords": [
    "anhur",
    "content",
    "mdx",
    "zod"
  ],
  "homepage": "https://github.com/DobroslavRadosavljevic/anhur/tree/main/packages/mdx#readme",
  "bugs": {
    "url": "https://github.com/DobroslavRadosavljevic/anhur/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DobroslavRadosavljevic/anhur.git",
    "directory": "packages/mdx"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@types/hast": "^3.0.4",
    "@types/mdx": "^2.0.14",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@anhur/core": "workspace:*",
    "@anhur/oxfmt": "workspace:*",
    "@anhur/oxlint": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bellona": "0.5.0",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@anhur/core": "workspace:^",
    "react": ">=18",
    "zod": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
