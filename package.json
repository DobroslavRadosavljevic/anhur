{
  "name": "anhur",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=vite-playground",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "release:login": "npm login --auth-type=web --scope=@anhur",
    "release:sync-check": "bun scripts/release.ts sync-check",
    "release:version": "bun scripts/release.ts version",
    "release:verify": "bun scripts/release.ts verify",
    "release:prepare": "bun scripts/release.ts prepare",
    "release:pack": "bun scripts/release.ts pack",
    "release:publish": "bun scripts/release.ts publish"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@tanstack/start-plugin-core": "1.170.0",
    "vite": "7.3.6"
  },
  "packageManager": "bun@1.2.19"
}
